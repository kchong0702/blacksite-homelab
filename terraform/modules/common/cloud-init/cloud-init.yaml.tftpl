#cloud-config
hostname: ${hostname}
%{ if harden_public_ip ~}
ssh_pwauth: false
packages:
  - ufw
%{ endif ~}
runcmd:
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key=${tailscale_auth_key} --hostname=${hostname} --advertise-tags=${join(",", tags)} --ssh
%{ if harden_public_ip ~}
  - ufw default deny incoming
  - ufw allow in on tailscale0
  - ufw --force enable
%{ endif ~}
